{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    },
    {
      "src": "server.ts",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "server.ts"
    },
    {
      "src": "/assets/(.*)",
      "dest": "/assets/$1"
    },
    {
      "src": "/pwa-(.*)",
      "dest": "/pwa-$1"
    },
    {
      "src": "/192x192.png",
      "dest": "/192x192.png"
    },
    {
      "src": "/pwa-192x192.svg",
      "dest": "/pwa-192x192.svg"
    },
    {
      "src": "/pwa-512x512.png",
      "dest": "/pwa-512x512.png"
    },
    {
      "src": "/registerSW.js",
      "dest": "/registerSW.js"
    },
    {
      "src": "/manifest.webmanifest",
      "dest": "/manifest.webmanifest"
    },
    {
      "src": "/sw.js",
      "dest": "/sw.js"
    },
    {
      "src": "/workbox-(.*)",
      "dest": "/workbox-$1"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
